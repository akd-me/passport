{
  "name": "passport",
  "private": true,
  "version": "0.0.1",
  "description": "Agent-native email: a harness that lets agents operate on your mail, calendar and contacts under a trust policy. Bring your own providers and models.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build && pnpm --filter @passport/web build && pnpm --filter @passport/server build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "biome check . && pnpm -r run typecheck",
    "dev": "pnpm --filter @passport/server dev",
    "demo": "pnpm --filter @passport/server demo",
    "pack": "pnpm build && pnpm --dir apps/server/dist/package pack --pack-destination ..",
    "docker:build": "docker build -t passport:local .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
