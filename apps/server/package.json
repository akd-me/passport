{
  "name": "@passport/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts demo",
    "demo": "tsx src/cli.ts demo",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@passport/store": "workspace:*",
    "@passport/providers": "workspace:*",
    "@passport/policy": "workspace:*",
    "@passport/agent": "workspace:*",
    "@passport/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@passport/types": "workspace:*",
    "@passport/tools": "workspace:*",
    "hono": "^4.10.0",
    "@hono/node-server": "^1.19.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7",
    "@passport/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "tsx": "^4.19.0",
    "@types/ws": "^8.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "passport": "bin/passport.js"
  },
  "files": [
    "bin/",
    "dist/",
    "web/",
    "README.md",
    "LICENSE"
  ]
}
