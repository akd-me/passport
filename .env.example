# Copy to .env and chmod 600 .env. Docker Compose reads this file.
# Empty model keys disable automatic triage; UI, sync and MCP still work.
PASSPORT_LLM_PROVIDER=anthropic
# Leave blank to use the selected provider's default; choose an available model.
PASSPORT_LLM_MODEL=
PASSPORT_LLM_FAST_MODEL=
PASSPORT_LLM_BASE_URL=
PASSPORT_LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: a strong, private secret. Empty generates /data/master.key (0600).
# Back up the selected key with your data. Changing it cannot decrypt old credentials.
PASSPORT_MASTER_KEY=
# For local models inside Docker, localhost means the container itself.
# Set PASSPORT_LLM_PROVIDER=ollama and PASSPORT_LLM_BASE_URL to a reachable Ollama host.
